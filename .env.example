# ============================================================
# Continuum — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked [REQUIRED FOR LIVE] put the pipeline into
# offline/stub mode when absent. The server still starts and all
# offline tests pass (11/11 + 3/3). Live mode requires Azure
# credentials; without them each agent runs its deterministic
# fallback and returns well-formed stub artifacts.
#
# Variables marked [OPTIONAL] have sensible defaults shown.
# ============================================================


# ── Azure AI Foundry / Azure OpenAI ─────────────────────────
# [REQUIRED FOR LIVE] API key from Portal → your resource → Keys and Endpoint
AZURE_OPENAI_API_KEY=

# [REQUIRED FOR LIVE] Endpoint URL
# Format: https://your-instance.openai.azure.com
# AI Foundry users: both AZURE_AI_ENDPOINT and AZURE_OPENAI_ENDPOINT are accepted
AZURE_OPENAI_ENDPOINT=
AZURE_AI_ENDPOINT=

# [OPTIONAL] API version (default used when absent)
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# [REQUIRED FOR LIVE] Deployment names per model tier
# Create deployments in Azure AI Studio → Deployments
AZURE_DEPLOYMENT_STRONG=gpt-4o
AZURE_DEPLOYMENT_CHEAP=gpt-4o-mini

# [OPTIONAL] Fallback deployment when STRONG/CHEAP not set
AZURE_DEPLOYMENT_ID=

# [OPTIONAL] Managed-identity client ID (use instead of API key with Azure MI)
AZURE_CLIENT_ID=


# ── Azure DevOps ─────────────────────────────────────────────
# [REQUIRED FOR LIVE] Organization URL — format: https://dev.azure.com/your-org
AZURE_DEVOPS_ORG=https://dev.azure.com/your-org
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org

# [REQUIRED FOR LIVE] Project name within the organization
AZURE_DEVOPS_PROJECT=your-project

# [REQUIRED FOR LIVE] Personal Access Token
# ADO → User Settings → Personal Access Tokens
# Required scopes: Work Items (Read & Write), Code (Read & Write)
AZURE_DEVOPS_TOKEN=
AZURE_DEVOPS_PAT=

# [REQUIRED FOR PR CREATION] Git repository name within the project
AZURE_DEVOPS_REPO=your-repo

# [OPTIONAL] Branch Continuum pushes generated code to
FEATURE_BRANCH=feature/continuum-auto


# ── Neo4j (task DAG + GraphRAG) ──────────────────────────────
# [OPTIONAL — defaults match docker-compose.yml]
# Start with: docker compose up -d neo4j
# For Neo4j Aura: neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=continuum-dev


# ── PostgreSQL (LangGraph checkpointer) ──────────────────────
# [OPTIONAL — defaults match docker-compose.yml]
# Start with: docker compose up -d postgres
# Both POSTGRES_URI and POSTGRES_DSN are accepted (URI takes precedence)
POSTGRES_URI=postgresql://continuum:continuum-dev@localhost:5432/continuum
POSTGRES_DSN=postgresql://continuum:continuum-dev@localhost:5432/continuum


# ── Azure Container Apps dynamic sandbox ─────────────────────
# [OPTIONAL] Required only for real code-execution sandboxing (M3+)
# Provision: az containerapp sessionpool create ...
ACA_SESSION_POOL_ENDPOINT=
ACA_AUTH_TOKEN=


# ── Application ───────────────────────────────────────────────
# [OPTIONAL] All have sensible defaults
ENVIRONMENT=development
LOG_LEVEL=INFO
REPO_PATH=.
PORT=8000
CONTINUUM_RUN_ID=
