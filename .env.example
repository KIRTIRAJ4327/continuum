# Azure AI Foundry
AZURE_OPENAI_API_KEY=your_key
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/
AZURE_DEPLOYMENT_ID=gpt-4-deployment-id

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Azure Container Apps (Sandbox)
ACA_SESSION_POOL_ENDPOINT=https://your-session-pool.azurecontainerapps.io
ACA_AUTH_TOKEN=your_token

# Azure DevOps
AZURE_DEVOPS_ORG=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_TOKEN=your_pat

# PostgreSQL (Checkpointer)
POSTGRES_URI=postgresql://user:password@localhost:5432/continuum

# App environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG
